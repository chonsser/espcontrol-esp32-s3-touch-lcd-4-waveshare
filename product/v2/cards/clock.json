{
  "label": "Date & Time",
  "allowInSubpage": true,
  "pickerKey": "calendar",
  "domains": [],
  "options": [
    {
      "name": "date_time_mode",
      "label": "Type",
      "kind": "choice",
      "values": ["clock", "datetime", "", "timezone"],
      "defaultValue": "clock",
      "storageField": "type",
      "omitDefault": false
    },
    {
      "name": "large_numbers",
      "label": "Large Clock",
      "kind": "flag",
      "omitDefault": true
    },
    { "name": "text_size", "label": "Text size", "kind": "choice", "values": ["", "small", "medium", "large"], "defaultValue": "", "omitDefault": true },
    { "name": "clock_font", "label": "Clock font", "kind": "choice", "values": ["", "thin", "bold", "mono"], "defaultValue": "", "omitDefault": true },
    { "name": "time_format", "label": "Time format", "kind": "text", "defaultValue": "", "omitDefault": true },
    { "name": "date_format", "label": "Date format", "kind": "text", "defaultValue": "", "omitDefault": true },
    { "name": "date_size", "label": "Date size", "kind": "choice", "values": ["", "small", "medium", "large"], "defaultValue": "", "omitDefault": true }
  ],
  "normalization": {
    "fields": {
      "entity": { "policy": "clear" },
      "label": { "policy": "clear" },
      "icon": { "policy": "default", "value": "Auto" },
      "icon_on": { "policy": "default", "value": "Auto" },
      "sensor": { "policy": "clear" },
      "unit": { "policy": "clear" },
      "type": { "policy": "default", "value": "clock" },
      "precision": { "policy": "clear" },
      "options": { "policy": "hook", "hook": "normalize_date_time_options" }
    },
    "unknownOptions": "drop",
    "canonicalOptionOrder": ["large_numbers", "text_size", "clock_font", "time_format", "date_format", "date_size"],
    "optionHook": "normalize_date_time_options"
  },
  "default": {
    "entity": "", "label": "", "icon": "Auto", "icon_on": "Auto",
    "sensor": "", "unit": "", "type": "clock", "precision": "", "options": ""
  }
}
