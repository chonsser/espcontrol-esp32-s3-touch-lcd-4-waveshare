      "options": "large_numbers=off,text_size=large,clock_font=mono,time_format=%25H%3A%25M%3A%25S,date_format=%25d.%25m.%25Y,date_size=small"
    }
  },
  {
    "name": "clock format preserves percent tokens followed by hex digits",
    "input": ";;;;;;clock;;time_format=%25d12,date_format=%25Y-%25m-%25d,clock_font=bold",
    "expected": {
      "entity": "", "label": "", "icon": "Auto", "icon_on": "Auto",
      "sensor": "", "unit": "", "type": "clock", "precision": "",
      "options": "clock_font=bold,time_format=%25d12,date_format=%25Y-%25m-%25d"
    }
  },
  {
