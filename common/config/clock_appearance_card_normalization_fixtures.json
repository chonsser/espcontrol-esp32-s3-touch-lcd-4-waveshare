    "expected": {
      "entity": "", "label": "", "icon": "Auto", "icon_on": "Auto",
      "sensor": "", "unit": "", "type": "clock", "precision": "",
      "options": "large_numbers,text_size=small"
    }
  },
  {
    "name": "clock expanded format length must also be bounded",
