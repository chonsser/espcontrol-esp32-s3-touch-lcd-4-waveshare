      "entity": "", "label": "", "icon": "Auto", "icon_on": "Auto",
      "sensor": "", "unit": "", "type": "clock", "precision": "",
      "options": "time_format= %25H ,date_size=medium"
    }
  },
  {
    "name": "clock invalid appearance falls back without losing existing size",
